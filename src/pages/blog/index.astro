---
import Layout from '../../layouts/Layout.astro';
import { getPosts, getCategories, getFeaturedImageUrl, getPostCategories, hasValidCategory } from '../../lib/wordpress';
import { Calendar, User, Newspaper, ArrowRight, Tag, BookOpen } from 'lucide-react';
import { url } from '../../lib/base';

const rawPosts = await getPosts(30);
// REGLA: Entrada que no tenga categorías no mostrarla en ningún lado
const posts = rawPosts.filter(hasValidCategory);
const rawCategories = await getCategories();
const categories = rawCategories.filter(c => c.slug !== 'uncategorized' && c.name.toLowerCase() !== 'sin categoría');
---

<Layout
  title="Blog & Actualidad | FUNDELIBERTAD"
  description="Noticias, artículos, comunicados y publicaciones sobre derechos humanos y actividades comunitarias en Medellín."
>
  <div class="bg-gradient-to-b from-sky-50/70 to-transparent py-12 border-b border-sky-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-primary text-white text-xs font-bold uppercase tracking-wider">
          <BookOpen className="w-3.5 h-3.5" />
          Publicaciones Institucionales
        </span>
        <h1 class="font-display font-black text-4xl sm:text-5xl text-brand-dark tracking-tight leading-tight">
          Blog de Derechos Humanos & Comunidad
        </h1>
        <p class="text-base text-slate-600 leading-relaxed">
          Consulta nuestros artículos de opinión, informes de gestión, alertas tempranas y novedades sobre la labor social y jurídica en la Comuna 15 Guayabal y Medellín.
        </p>

        {categories.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            <span class="text-xs font-bold text-slate-400 self-center mr-1">Categorías:</span>
            {categories.map((cat) => (
              <span class="px-3 py-1 rounded-full bg-white border border-slate-200 text-xs font-medium text-slate-700 shadow-2xs">
                {cat.name} ({cat.count})
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    {posts.length === 0 ? (
      <div class="bg-white rounded-3xl p-16 text-center border border-slate-200 shadow-xs max-w-xl mx-auto space-y-4">
        <Newspaper className="w-16 h-16 text-slate-300 mx-auto" />
        <h2 class="font-display font-bold text-2xl text-slate-800">No se encontraron artículos</h2>
        <p class="text-sm text-slate-500 leading-relaxed">
          Las publicaciones añadidas en WordPress en <code class="bg-slate-100 px-1 py-0.5 rounded text-xs text-brand-primary">csm.fundelibertad.org</code> aparecerán aquí de forma automática.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => {
          const featuredImg = getFeaturedImageUrl(post);
          const postCats = getPostCategories(post);
          const dateStr = new Date(post.date).toLocaleDateString('es-CO', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });

          return (
            <article class="bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
              <div class="relative h-52 overflow-hidden bg-slate-100">
                <img
                  src={featuredImg}
                  alt={post.title.rendered}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                {postCats.length > 0 && (
                  <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-sm px-3 py-1 rounded-lg text-xs font-bold text-brand-primary shadow-xs">
                    {postCats[0]}
                  </span>
                )}
              </div>

              <div class="p-6 flex flex-col flex-grow justify-between space-y-4">
                <div class="space-y-3">
                  <div class="flex items-center gap-3 text-xs text-slate-400 font-medium">
                    <span class="flex items-center gap-1.5">
                      <Calendar className="w-3.5 h-3.5 text-slate-400" />
                      {dateStr}
                    </span>
                  </div>

                  <h2 class="font-display font-bold text-xl text-slate-900 group-hover:text-brand-primary transition-colors leading-snug">
                    <a href={url(`/blog/${post.slug}`)}>
                      <span set:html={post.title.rendered} />
                    </a>
                  </h2>

                  <div
                    class="text-xs text-slate-500 line-clamp-3 leading-relaxed"
                    set:html={post.excerpt.rendered}
                  />
                </div>

                <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                  <a
                    href={url(`/blog/${post.slug}`)}
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-primary hover:text-sky-800 transition-colors"
                  >
                    Leer publicación
                    <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</Layout>
