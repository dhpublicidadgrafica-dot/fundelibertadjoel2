---
import Layout from '../layouts/Layout.astro';
import DynamicPostReader from '../components/DynamicPostReader';
---

<Layout
  title="Entrada | FUNDELIBERTAD"
  description="Artículo de FUNDELIBERTAD"
>
  <DynamicPostReader client:only="react" />
</Layout>

<style is:global>
  /* Estilos para el contenido renderizado desde WordPress Gutenberg/Classic */
  .wp-content p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }
  .wp-content h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: #0a0a0a;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .wp-content h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: #0a0a0a;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .wp-content ul {
    list-style-type: disc;
    padding-left: 1.75rem;
    margin-bottom: 1.5rem;
    space-y: 0.5rem;
  }
  .wp-content ol {
    list-style-type: decimal;
    padding-left: 1.75rem;
    margin-bottom: 1.5rem;
    space-y: 0.5rem;
  }
  .wp-content blockquote {
    border-left: 4px solid #2d88c4;
    padding-left: 1.25rem;
    font-style: italic;
    color: #4b5563;
    margin: 1.75rem 0;
  }
  .wp-content img {
    border-radius: 1rem;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto;
  }
  .wp-content a {
    color: #2d88c4;
    text-decoration: underline;
    font-weight: 600;
  }
  .wp-content a:hover {
    color: #1a5680;
  }
</style>

