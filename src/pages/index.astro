---
import Layout from '../layouts/Layout.astro';
import HomeSection from '../components/sections/HomeSection';
import { getPosts, getFeaturedImageUrl, getPostCategories, hasValidCategory } from '../lib/wordpress';
import { ArrowRight, Calendar, Newspaper } from 'lucide-react';
import { url } from '../lib/base';

const rawPosts = await getPosts(10);
// REGLA: Entrada que no tenga categorías no mostrarla en ningún lado
const posts = rawPosts.filter(hasValidCategory).slice(0, 3);
---

<Layout title="FUNDELIBERTAD | Inicio - Defendiendo los Derechos Humanos">
  <HomeSection client:load />

  {/* SECCIÓN DEL BLOG DE WORDPRESS */}
  <section class="py-16 border-t border-sky-100" id="latest-blog-posts">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-100 text-brand-primary text-xs font-bold uppercase tracking-wider mb-2">
          <Newspaper className="w-3.5 h-3.5" />
          Actualidad & Comunicados
        </span>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-brand-dark tracking-tight">
          Últimas Entradas del Blog
        </h2>
        <p class="text-sm text-slate-500 mt-2 max-w-xl">
          Información actualizada, artículos de derechos humanos y novedades de la comunidad gestionadas desde nuestro portal WordPress.
        </p>
      </div>
      <a
        href={url('/blog')}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-primary hover:bg-sky-700 text-white font-bold text-sm shadow-md transition-all self-start md:self-auto cursor-pointer"
      >
        Ver Todo el Blog
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>

    {posts.length === 0 ? (
      <div class="bg-white rounded-2xl p-12 text-center border border-dashed border-slate-200">
        <Newspaper className="w-12 h-12 text-slate-300 mx-auto mb-3" />
        <h3 class="text-base font-bold text-slate-700">No hay entradas publicadas aún</h3>
        <p class="text-xs text-slate-400 mt-1">Crea tus artículos en el panel de WordPress para que aparezcan aquí automáticamente.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => {
          const featuredImg = getFeaturedImageUrl(post, 'https://lh3.googleusercontent.com/d/1mzMGHUgDdHcX8hpf8DTMLIs2Dv53CCsd');
          const categories = getPostCategories(post);
          const dateStr = new Date(post.date).toLocaleDateString('es-CO', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          });

          return (
            <article class="bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
              <div class="relative h-48 overflow-hidden bg-slate-100">
                <img
                  src={featuredImg}
                  alt={post.title.rendered}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                {categories.length > 0 && (
                  <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2.5 py-1 rounded-md text-[11px] font-bold text-brand-primary shadow-xs">
                    {categories[0]}
                  </span>
                )}
              </div>

              <div class="p-6 flex flex-col flex-grow justify-between space-y-4">
                <div class="space-y-2">
                  <div class="flex items-center gap-3 text-[11px] text-slate-400 font-medium">
                    <span class="flex items-center gap-1">
                      <Calendar className="w-3.5 h-3.5 text-slate-400" />
                      {dateStr}
                    </span>
                  </div>

                  <h3 class="font-display font-bold text-lg text-slate-900 group-hover:text-brand-primary transition-colors line-clamp-2 leading-snug">
                    <a href={url(`/blog/${post.slug}`)}>
                      <span set:html={post.title.rendered} />
                    </a>
                  </h3>

                  <div
                    class="text-xs text-slate-500 line-clamp-3 leading-relaxed"
                    set:html={post.excerpt.rendered}
                  />
                </div>

                <a
                  href={url(`/blog/${post.slug}`)}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-primary hover:text-sky-800 transition-colors pt-2 border-t border-slate-50"
                >
                  Leer artículo completo
                  <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </a>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>
</Layout>
